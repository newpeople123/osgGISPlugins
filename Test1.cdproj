    ]]></Query>
          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 6-4-2 Derived classes shall not conceal functions that are inherited from their bases</Name>
