//Description]]></Query>
        <Query Active="True" Locked="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>Big methods</Name>
from m in Methods where m.NbLinesOfCode>100 && m.NbLinesOfCode<=150
orderby m.NbLinesOfCode descending
select new{m,m.NbLinesOfCode}]]></Query>
        <Query Active="True" Locked="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>Too big methods</Name>
from m in Methods where m.NbLinesOfCode>150
orderby m.NbLinesOfCode descending
select new{m,m.NbLinesOfCode}]]></Query>
