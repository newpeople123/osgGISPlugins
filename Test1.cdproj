      <Group Name="Code Design" Active="True" ShownInReport="True">
        <Query Active="True" Locked="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>Methods with too many parameters</Name>
from m in Methods where m.NbParameters>15
