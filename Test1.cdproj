        <Query Active="True" Locked="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Methods naming issues</Name>
from m in Methods
where 
    !m.IsGeneratedByCompiler && !m.IsConstructor && !m.IsDestructor && !m.IsThirdParty &&
    !m.SimpleNameLike("^operator.*") && // exclude operator overloads
    (
        // Public/protected methods: must be camelCase OR PascalCase
        ((m.IsPublic || m.IsProtected) &&
            !(m.SimpleNameLike("^[a-z][A-Za-z0-9]*$") || m.SimpleNameLike("^[A-Z][A-Za-z0-9]*$")))

        ||

        // Private/internal methods: must be camelCase
        (m.IsPrivate  &&
            !m.SimpleNameLike("^[a-z][A-Za-z0-9]*$"))
    )
select new { 
    m, 
    m.Visibility,
    ViolationReason = 
        (m.IsPublic || m.IsProtected) ? 
            "Public/protected method should be camelCase or PascalCase" : 
            "Private/internal method should be camelCase"
}
]]></Query>
        <Query Active="True" Locked="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Fields naming issues</Name>
from f in Fields
where 
    !f.IsEnumValue &&
     // exclude enum members
    (
        // Rule 1: Private instance fields
        (f.IsPrivate && !f.IsStatic &&
            !(f.NameLike("^_.*") || f.NameLike("^m_.*") || f.NameLike(".*_$")))

        ||

        // Rule 2: Public instance fields
        (f.IsPublic && !f.IsStatic &&
            !f.NameLike("^[a-z][A-Za-z0-9]*$") &&   // camelCase
            !f.NameLike("^[A-Z][A-Za-z0-9]*$"))     // PascalCase

        ||

        // Rule 3: Private static fields
        (f.IsPrivate && f.IsStatic &&
            !f.NameLike("^s_.*"))

        ||

        // Rule 4: Public static fields
        (f.IsPublic && f.IsStatic &&
            !(f.NameLike("^s_.*") || f.NameLike("^[A-Z0-9_]+$")))
    )
select new { 
    f, 
    f.Visibility, 
    f.IsStatic,
    ViolationReason =
        f.IsPrivate && !f.IsStatic ? "Private instance field should start with '_' or 'm_' or end with '_'"
      : f.IsPublic && !f.IsStatic ? "Public instance field should be camelCase or PascalCase"
      : f.IsPrivate && f.IsStatic ? "Private static field should start with 's_'"
      : f.IsPublic && f.IsStatic  ? "Public static field should start with 's_' or be ALL_CAPS"
      : "Unknown violation"
}
]]></Query>
        <Query Active="True" Locked="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>Types naming issues</Name>
from t in Types
where 
    !t.IsThirdParty  &&
    (
        // Must be PascalCase
        !t.SimpleNameLike("^[A-Z][A-Za-z0-9]*$")

        ||

        // Should not start with underscore
        t.SimpleNameLike("^_.*")
    )
select new { 
    t, 
   
    ViolationReason = 
        t.SimpleNameLike("^_.*") ? 
            "Type name should not start with an underscore" : 
            "Type name should be PascalCase (e.g. MyClass)"
}
]]></Query>
