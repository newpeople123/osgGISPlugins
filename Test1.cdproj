          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 6-0-2 When an array with external linkage is declared, its size should be explicitly specified</Name>
//<RuleID>MISRA6-0-2</RuleID>
warnif count > 0 
from issue in ImportedIssues where issue.Type=="warn_external_array"
select new { issue, FileName = issue.SourceDecl.SourceFile.FileName,Line = issue.BeginLine ,issue.FilePath,
     Debt = 10.ToMinutes().ToDebt(),
     Severity =Severity.High
}

//<Description>
// You can get rule details from the Misra website https://misra.org.uk/
//</Description>
    ]]></Query>
          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 6-0-3 The only declarations in the global namespace should be main, namespace declarations and extern "C" declarations</Name>
//<RuleID>MISRA6-0-3</RuleID>
warnif count > 0 
from method in JustMyCode.Methods where method.SimpleName!="main" && method.IsGlobal && !method.IsExternC && method.ParentNamespace.Name==""
select new { method,
     Debt = 10.ToMinutes().ToDebt(),
     Severity =Severity.High
}

//<Description>
// You can get rule details from the Misra website https://misra.org.uk/
//</Description>
    ]]></Query>
          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 6-0-4 The identifier main shall not be used for a function other than the global function main</Name>
//<RuleID>MISRA6-0-4</RuleID>
warnif count > 0 
from method in JustMyCode.Methods where method.SimpleName=="main" && method.IsGlobal &&  method.ParentNamespace.Name!=""
select new { method,
     Debt = 10.ToMinutes().ToDebt(),
     Severity =Severity.High
}

//<Description>
// You can get rule details from the Misra website https://misra.org.uk/
//</Description>
    ]]></Query>
          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 6-2-4 A header file shall not contain definitions of functions or objects that are non-inline and have external linkage</Name>
//<RuleID>MISRA6-2-4</RuleID>
warnif count > 0 
from m in JustMyCode.Methods where m.NbLinesOfCode>0 && !m.IsInline
&& m.SourceDecls.First().SourceFile.FileNameExtension.StartsWith("h")
select new { m,IncludeFile=m.SourceDecls.First().SourceFile.FilePathString,
     Debt = 10.ToMinutes().ToDebt(),
     Severity =Severity.High }

//<Description>
// You can get rule details from the Misra website https://misra.org.uk/
//</Description>
    ]]></Query>
          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 6-4-1 A variable declared in an inner scope shall not hide a variable declared in an outer scope</Name>
//<RuleID>MISRA6-4-1</RuleID>
warnif count > 0 
from issue in ImportedIssues where issue.Type=="warn_decl_shadow"
select new { issue, FileName = issue.SourceDecl.SourceFile.FileName,Line = issue.BeginLine ,issue.FilePath,
     Debt = 10.ToMinutes().ToDebt(),
     Severity =Severity.High
}

