//</Description>



    ]]></Query>
          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 0-0-2: Controlling expressions should not be invariant</Name>
//<RuleID>MISRA0-0-2</RuleID>
warnif count > 0         
from issue in ImportedIssues 
where issue.ToolName=="CppCheck" && issue.Type=="knownConditionTrueFalse" select 
