// and ultimately raise the MI score for their methods.  

// </Description>]]></Query>
        <Query Active="True" Locked="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>Partially Maintainable Methods</Name>
from m in Methods where m.MaintainabilityIndex>=30 && m.MaintainabilityIndex<50
