]]></Query>
          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 0-2-1: Variables with limited visibility should be used at least once</Name>
//<RuleID>MISRA0-2-1</RuleID>
warnif count > 0         
from issue in ImportedIssues 
where issue.ToolName=="Clang" && issue.Type=="warn_unused_variable" select 
new { issue, FileName = issue.SourceDecl.SourceFile.FileName,Line = issue.BeginLine ,issue.FilePath,
