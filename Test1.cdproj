          <Query Active="True" Locked="True" DisplayList="True" DisplayStat="True" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[//<Name>MISRA 7-11-2 An array passed as a function argument shall not decay to a pointer</Name>
